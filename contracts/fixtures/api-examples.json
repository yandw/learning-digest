    {
      "id": "api-resource-retitle",
      "description": "手动补标题（contract §3.7，第一轮补充）：PATCH 仅接受非空 title，返回更新后的 Resource；kind 与 createdAt 不变",
      "endpoint": { "method": "PATCH", "path": "/v1/resources/res_01JABC0010" },
      "request": {
        "body": {
          "title": "建立学习习惯的复利方法"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "resource": {
