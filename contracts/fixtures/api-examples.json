{
  "$contract": "learning-digest-contracts/v1",
  "description": "/v1 六组核心端点加 §3.7 补充端点（手动补标题）的成功样例。错误样例（401/404/409/400）在 error-examples.json。样例之间互相引用同一批 res_/src_/note_ id：重复收藏、笔记重发、进度链与详情读取跨样例保持一致，三端测试可直接以此为准。样例仅覆盖成功响应；状态码约定：创建 201、命中已有数据 200。",
  "samples": [
    {
      "id": "api-resources-create-bilibili-p2",
      "description": "首次收藏 B 站 P2 分集：创建 Resource + Source，返回 201",
      "endpoint": { "method": "POST", "path": "/v1/resources" },
      "request": {
        "body": {
          "url": "https://www.bilibili.com/video/BV1ab411L78c?p=2",
          "title": "注意力机制详解 P2：自注意力",
          "identity": {
            "platformId": "bilibili",
            "platformVideoId": "BV1ab411L78c",
            "episodeId": "2"
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "resource": {
            "id": "res_01JABC0001",
            "title": "注意力机制详解 P2：自注意力",
            "kind": "video",
            "createdAt": "2026-11-10T08:00:00Z"
          },
          "source": {
            "id": "src_01JABC0002",
            "resourceId": "res_01JABC0001",
            "kind": "video",
            "url": "https://www.bilibili.com/video/BV1ab411L78c?p=2",
            "platformId": "bilibili",
            "platformVideoId": "BV1ab411L78c",
            "episodeId": "2",
            "platformScopeId": null,
            "progress": null
          }
        }
      }
    },
    {
      "id": "api-resources-duplicate-bilibili-p2",
      "description": "重复收藏：用可识别分享短链再收藏同一分集，返回 200 与同一条 Resource + Source；原始 URL 保留首次收藏的地址",
      "endpoint": { "method": "POST", "path": "/v1/resources" },
      "request": {
        "body": {
          "url": "https://b23.tv/BV1ab411L78c?p=2&share_medium=android&share_plat=android",
          "title": "注意力机制详解 P2：自注意力",
          "identity": {
            "platformId": "bilibili",
            "platformVideoId": "BV1ab411L78c",
            "episodeId": "2"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "resource": {
            "id": "res_01JABC0001",
            "title": "注意力机制详解 P2：自注意力",
            "kind": "video",
            "createdAt": "2026-11-10T08:00:00Z"
          },
          "source": {
            "id": "src_01JABC0002",
            "resourceId": "res_01JABC0001",
            "kind": "video",
            "url": "https://www.bilibili.com/video/BV1ab411L78c?p=2",
            "platformId": "bilibili",
            "platformVideoId": "BV1ab411L78c",
            "episodeId": "2",
            "platformScopeId": null,
            "progress": null
          }
        }
      }
    },
    {
      "id": "api-resources-create-generic-webpage",
      "description": "收藏普通网页：无 identity，服务端按归一化地址匹配；创建 201",
