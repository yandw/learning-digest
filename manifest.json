{
  "manifest_version": 3,
  "name": "Learning Digest",
  "version": "0.1.5",
  "minimum_chrome_version": "116",
  "description": "Turn live course audio into a learning resource with segment-by-segment transcription, rolling summaries, and a full-session digest.",
  "permissions": ["sidePanel", "storage", "tabCapture", "offscreen"],
  "host_permissions": [
    "https://*.xiaoe-tech.com/*",
    "https://api.deepseek.com/*",
    "https://openrouter.ai/*",
    "https://api.groq.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.xiaoe-tech.com/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Learning Digest",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
