{
  "manifest_version": 3,
  "name": "Learning Digest",
  "version": "0.1.38",
  "minimum_chrome_version": "116",
  "description": "把课程音频变成学习资料：分段中文转写、话题时间轴和完整的学习纪要。",
  "permissions": ["sidePanel", "storage", "tabCapture", "offscreen"],
  "host_permissions": [
    "https://*.xiaoe-tech.com/*",
    "https://api.deepseek.com/*",
    "https://openrouter.ai/*",
    "https://api.groq.com/*",
    "https://dashscope.aliyuncs.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.xiaoe-tech.com/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Learning Digest",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
